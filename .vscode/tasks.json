{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LaTeX: 编译论文 PDF",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\build.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "LaTeX: 持续监听并编译",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\watch.ps1"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "LaTeX: 清理编译文件",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\build.ps1",
        "-Clean"
      ],
      "problemMatcher": []
    }
  ]
}
